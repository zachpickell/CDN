# --- existing app config ---
APP_PASSWORD=
SESSION_SECRET=
# Where files + metadata live (defaults to ./storage). Point this at your real
# storage on falc, e.g. /mnt/storage
DATA_DIR=

# --- local RAG (Ask your files) ---
# Ollama endpoint (embeddings + chat). Default assumes Ollama on the same host.
OLLAMA_URL=http://127.0.0.1:11434
# Qdrant endpoint (see docker-compose.rag.yml).
QDRANT_URL=http://127.0.0.1:6333
# Set only if you enabled an API key on Qdrant.
QDRANT_API_KEY=
# Models (pull them with `ollama pull <name>` on falc first).
RAG_EMBED_MODEL=nomic-embed-text
RAG_CHAT_MODEL=qwen2.5:7b-instruct
# Vector size MUST match the embed model (nomic-embed-text = 768,
# mxbai-embed-large = 1024).
RAG_EMBED_DIM=768
# Qdrant collection name.
RAG_COLLECTION=cdn_rag
# Optional: extra absolute directories to index that aren't in the CDN store
# (e.g. code repos). Comma-separated. These are cited by path, without a
# share link.
# RAG_EXTRA_ROOTS=/mnt/storage/code,/home/zach/projects
